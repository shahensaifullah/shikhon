DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=shikhon-backend
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

OTP_PROVIDER_ENABLED=False
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
ALLOW_DEVELOPMENT_OTP=False
DEVELOPMENT_OTP=123456
OTP_EXPIRY_SECONDS=180
OTP_MAX_ATTEMPTS=5

JWT_SIGNING_KEY=replace-with-an-independent-long-random-secret
ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=2
REFRESH_COOKIE_NAME=shikhon_refresh
REFRESH_COOKIE_PATH=/api/accounts/auth
REFRESH_COOKIE_SECURE=True
REFRESH_COOKIE_SAMESITE=Lax
